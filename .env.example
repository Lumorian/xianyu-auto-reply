# ================= 网络 / 代理 =================
# 本工具所有出站请求（闲鱼 HTTP / 长连接、扫码、new-api / 卡密站）一律直连，
# 不读 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / WS_PROXY 这些环境变量。
# 原因是闲鱼看登录 IP：挂上代理出口一变，长连接就被服务端踢掉（后台显示「账号掉线」）。
# 如果你用的是 TUN / 全局模式（FlClash、Clash Verge、TProxy），那是系统路由层，
# 需要在代理客户端里给 .venv/bin/python 和闲鱼域名加 DIRECT，见 README「代理 / TUN」一节。

# ================= 基础 =================
XY_DB_PATH=./data/app.db
# 监听非回环地址（如 0.0.0.0）时必须同时配置 XY_ADMIN_TOKEN，否则进程拒绝启动。
XY_HOST=127.0.0.1
XY_PORT=8000
# 设置后所有 /api 请求需带 X-Admin-Token 头；
# 页面用 http://127.0.0.1:8000/#token=xxx 打开（# 后面的内容不会发给服务器，
# 也不会进访问日志；读完会自动从地址栏抹掉）
XY_ADMIN_TOKEN=
# 仅保留兼容：当前版本不会放宽「无口令访问」。实际鉴权只看 XY_ADMIN_TOKEN；
# 没配口令时远程请求一律 401，配了口令远程带 token 即可用。
XY_ADMIN_ALLOW_REMOTE=0
# 额外允许的 Host（逗号分隔）。默认放行回环名字、XY_HOST 和任何纯 IP；
# 用域名/反代访问时必须把域名加进来，否则会被 Host 校验挡掉。
XY_ALLOWED_HOSTS=
XY_LOG_LEVEL=INFO
# 日志文件（自动轮转：单文件 10MB，保留 5 份）。留空则只输出到控制台，
# 适合交给 systemd / docker 收集
XY_LOG_FILE=./logs/server.log
XY_LOG_MAX_BYTES=10485760
XY_LOG_BACKUP_COUNT=5

# ================= 小内存设备（512 MB） =================
# 总内存 <= 768 MB 时自动进入小内存模式；也可以强制打开。
# XY_LOW_MEMORY=1
# 同时处理图片/视频的请求数（1~8）。小内存默认 1，普通机器默认 2。
# XY_MEDIA_CONCURRENCY=1
# 进程 RSS 超过这个值就在日志里告警（MB）。
# XY_MEMORY_WARN_MB=400

# ================= 图片 / 视频 =================
# 内置图片库与聊天视频本地副本目录（默认在 data/ 下，跟着 .gitignore 一起忽略）
XY_MEDIA_DIR=./data/media
# 单张图片 / 单个视频上传上限（MB）。视频走闲鱼 IM 分片上传，太大要等很久。
XY_MAX_IMAGE_MB=10
XY_MAX_VIDEO_MB=20
# 单个 HTTP 请求体上限（MB，1~256）。必须大于图片/视频上限；FastAPI 在鉴权前就会读 body。
XY_MAX_BODY_MB=32
# 发视频需要宿主机装 ffmpeg / ffprobe（用来读时长、截封面）：
#   Debian/Ubuntu: sudo apt install ffmpeg
#   没有装时，文本和图片照常，发视频会提示 503。

# ================= 登录态保活（防掉登录） =================
# IM accessToken 进程内缓存（秒）。重连越频繁越有用，0 = 不缓存。
XY_IM_TOKEN_TTL=14400
# _m_h5_tk 主动刷新间隔（秒），在 min~max 之间随机，避免固定节奏。0 = 关闭主动刷新。
XY_MH5TK_REFRESH_MIN=5400
XY_MH5TK_REFRESH_MAX=9000
# 登录态维护间隔（秒）：调一次 passport hasLogin.do（只顺带合并 Cookie，
# 它**判断不了**登录态也**续不了期**，实测对垃圾 Cookie 也回「登录态已失效」），
# 然后用业务接口 mtop.idle.web.user.page.nav 做一次真正的自检。0 = 关闭。
XY_SESSION_KEEPALIVE_INTERVAL=1800
# 登录态到期预警（小时）。闲鱼网页登录态按登录时刻算，实测 24 小时整到期；
# 到点在这之前这么多小时就在日志/后台提示「该重新扫码了」。0 = 不预警。
XY_RELOGIN_WARN_HOURS=20

# ================= 凭据落库加密 =================
# 账号 Cookie 用 AES-256-GCM 加密后再进 SQLite（老数据启动时自动就地加密）。
# 设成 0 会退回明文 —— 只在「要把库拷给别人排查」时临时用，且事后务必改回来。
XY_COOKIE_ENCRYPTION=1
# 密钥文件（默认 data/cookie.key，权限 0600）。
# 丢了 = 库里所有 Cookie 都读不出来 = 所有账号重新扫码。
# 备份数据库时**不要**把它一起带走，否则备份泄露依然等于账号泄露。
# 一般不用配：不配时密钥会自动「跟着数据库走」——
#   默认库(data/app.db) → data/cookie.key；用 XY_DB_PATH 指到别的库 → <那个库>.key。
# 只有在「密钥想放在别的盘 / 别的目录」时才需要显式写这一行。
# XY_COOKIE_KEY_FILE=./data/cookie.key

# ================= 发货行为 =================
XY_DELIVERY_COOLDOWN=600
XY_SEND_RETRY=2
# 1 = 只打日志不真发（也不会真的去建 Key）。首次上线建议先开
XY_DRY_RUN=0
# 订单轮询间隔（秒）。0 = 关闭。
# 闲鱼的消息推送会因为断线/风控漏消息，订单状态是「拉」得到的，更可靠。
# 这是「一直没有任何推送」时的兜底节奏；平时发包一到就会提前叫醒轮询，
# 所以实际发货延迟通常在几秒内。想更稳（或更保守）就调这个数。
XY_ORDER_POLL_INTERVAL=30
# 收到推送后多久允许再补查一次订单（秒），防止消息多时把接口打爆。0 = 关闭加速。
XY_ORDER_HINT_POLL_GAP=5
# 一次轮询里同时处理几单。1 = 串行。并发越高，多人同时下单时越快。
XY_ORDER_POLL_CONCURRENCY=3
# 同一个订单的详情缓存多久（秒）：补商品 ID 和取金额共用一次查询。0 = 不缓存。
XY_ORDER_CACHE_TTL=30
# 1 = 把收到的每条原始消息负载写进日志。排查「为什么没发货」时打开，
# 平时关掉（消息多的时候会刷屏）
XY_DEBUG_PAYLOAD=0

# 会话列表轮询间隔（秒）。0 = 关闭。
# 私信正文不一定会走 WebSocket 推送（线上实测经常只推「某会话有新消息」的
# 未读标记、不给正文），所以另外按这个节奏拉一次最近会话，
# 把每个会话的最后一条消息当新消息处理（按服务端 messageId 去重）。
XY_MESSAGE_POLL_INTERVAL=20
XY_MESSAGE_POLL_LIMIT=20
# 发现会话有新消息时，往回补拉多少条历史（1~50）。
# 买家连发两条时只看「最后一条」会漏，所以按会话补一段。
XY_MESSAGE_HISTORY_LIMIT=20
# 每轮最多给几个会话补拉历史（每次都算一趟 WS 往返）。0 = 永只看最后一条。
XY_MESSAGE_HISTORY_CONVERSATIONS=5
# 消息流水保留天数，0 = 永久保留。会清 messages 和 data/media/chat 下的过期视频副本；
# seen_messages / reply_hits 不清（否则「同一会话只回一次」和去重会失效）。
# 后台「聊天」页展示的也是这张表，保留天数太短会让聊天历史变少。
XY_MESSAGE_RETENTION_DAYS=30
# WebSocket 心跳间隔（秒）与 /reg→ackDiff 间隔（秒）。一般不用改。
XY_HEARTBEAT_INTERVAL=10
XY_REGISTER_GAP=1
# ackDiff 同步位点重发间隔（秒）。增量推送是服务端对 ackDiff 的响应，
# 只发一次基本收不到新消息；0 = 只发一次（不推荐）。
XY_SYNC_POLL_INTERVAL=30

# ================= 自动回复（商品 / 关键词） =================
# 总开关：1 = 命中规则自动回私信，0 = 全关（只发货，不搭理）
XY_AUTO_REPLY=1
# 回复前等几秒，避免「秒回」显得像机器人。0 = 立刻回
XY_AUTO_REPLY_DELAY=1

# ================= 自动评价 =================
# 买家确认收货后，闲鱼会推「快给ta一个评价吧」系统卡片。
# 默认关闭：评价是公开且不可撤销的，开启前请确认业务上要这样做。
# 后台「设置 → 自动评价」保存过以后以数据库为准。
XY_AUTO_RATE=0
# 评价文案，支持 {buyer} {item_id} {order_id} {date}，最多 200 字
XY_AUTO_RATE_FEEDBACK=不错的买家，交易愉快～
# 评价请求推送漏了时，扫最近成交订单的间隔（秒）；0 = 关闭轮询
XY_AUTO_RATE_POLL_INTERVAL=600

# ================= 金额与额度 =================
# 订单金额(元) 换算成「额度」的倍率基数。1 = 1:1（订单 10 元 → 额度 10）。
# 想按真实汇率收窄就填 7.3（USD 站点：订单 10 元 → 额度 1.37）。
#
# 注意：这里填的是「订单金额要除以多少才是额度数字」，**只对 USD 展示站点生效**。
# CNY / CUSTOM 站点的 quota 本身按展示货币计价，程序会直接用订单金额，
# 不会再按这个值除一次（否则 10 元订单在 CNY 7.3 站点只剩 ¥1.37）。
# 真正下发给 new-api 的 quota 仍会按站点展示货币换算：
# CNY 站点 1 元订单得到 ¥1，不会因为汇率多给 7 倍。不用手动补偿。
XY_CNY_PER_USD=1
# 订单金额单位：auto / yuan / fen。auto 会把 >=1000 的纯整数当「分」
XY_ORDER_AMOUNT_UNIT=auto
# 单笔订单金额上限（元），超过不发货。强烈建议填，防标错价被刷。0 = 不限
XY_MAX_ORDER_CNY=200

# ================= 上游一：new-api =================
# 「充值到买家已有 Key」模式只依赖这一段；不配卡密站也能用。
XY_NEWAPI_BASE_URL=https://api.lumorian.org
# 系统访问令牌（个人设置里生成）。这是长期有效的，填了就不用账号密码。
# 账号模式（开号 / 充值到账号）要求这枚令牌勾上「管理 → 用户 查看 + 编辑」，
# 否则查账号、建号、加额度都会 403；其它管理权限（渠道 / 系统设置等）一律别勾。
XY_NEWAPI_ACCESS_TOKEN=
# 不填 ACCESS_TOKEN 时用它俩登录（登录响应里能顺带拿到 user id）
XY_NEWAPI_USERNAME=
XY_NEWAPI_PASSWORD=
# 【0.13.x 必填】new-api 后台用户 id。所有后台接口都要带 New-Api-User 头，
# 少了会 401。填 access_token 时无法自动探测，必须手工填。
# 在后台「个人设置」页或个人头像处能看到；也可以是 /api/user/self 返回的 data.id
XY_NEWAPI_USER_ID=
# 令牌落在哪个分组，留空 = 默认分组
XY_NEWAPI_GROUP=
# 可选前缀。令牌名 = [前缀]买家用户名#订单号（如 测试小鱼#2500000000000000003）。
# 默认不加前缀；整体控制在 50 字节内，超长时先截用户名、订单号保持完整。
XY_NEWAPI_TOKEN_PREFIX=
# 新建令牌只允许使用的模型（逗号分隔）。默认只放行 deepseek-v4.1-flash，
# 防止买家拿 Key 去调更贵的模型。留空 = 不限制（等于关掉这层保护，慎用）。
# 只影响之后新建的 Key；已经发出去的旧 Key 要在 new-api 后台手动补限制。
#
# 注意：这一项现在**建议直接在 web 后台「设置」页改**（保存即生效，不用重启）。
# 后台保存过之后以后台为准，这里的值只在后台没配过时作为默认值。
# 想给不同商品发不同模型：去后台「设置 → 按商品指定模型」加一行（不需要改这里）。
XY_NEWAPI_MODEL_LIMITS=deepseek-v4.1-flash
# $1 对应多少 quota，留空自动读 /api/status（你这个站是 500000）
XY_NEWAPI_QUOTA_PER_UNIT=

# ================= 上游二：卡密站 =================
# 只有「按订单金额建新 Key 出卡密」需要卡密站；
# 「充值到买家已有 Key」不建卡密，这里留空也能正常发货。
XY_CARDSHOP_BASE_URL=https://shop.lumorian.org
# 二选一：管理令牌，或后台账号密码
XY_CARDSHOP_ADMIN_TOKEN=
XY_CARDSHOP_USERNAME=
XY_CARDSHOP_PASSWORD=
XY_CARDSHOP_GROUPS=5
